+function rematchRedux.battle.NotesButton:OnMouseUp()
+    if self:IsEnabled() then
+        self.Background:SetPoint("CENTER")
+        self.Icon:SetPoint("CENTER")
+        self.Icon:SetVertexColor(0.9,0.9,0.9)
