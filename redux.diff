+    rematchRedux.cardManager:ShowCard(rematchRedux.notes,petID)
+    rematchRedux.notes:SetFocus()
+end
+
+
+function rematchRedux.petMenu:PetCantLevel(petID)
+    return not rematchRedux.queue:PetIDCanLevel(petID)
+end
+
+function rematchRedux.petMenu:PetLevelingOrCant(petID)
+    return not rematchRedux.queue:PetIDCanLevel(petID) or rematchRedux.petInfo:Fetch(petID).isLeveling
+end
+
+function rematchRedux.petMenu:ToggleQueueText(petID)
+    return rematchRedux.queue:IsPetLeveling(petID) and L["Remove from Leveling Queue"] or L["Add to Leveling Queue"]
+end
+
+-- adds or removes petID to/from the leveling queue
+function rematchRedux.petMenu:ToggleQueueFunc(petID)
+    if rematchRedux.queue:PetIDCanLevel(petID) then
+        if rematchRedux.queue:IsPetLeveling(petID) then
+            rematchRedux.queue:RemovePetID(petID)
+        else
+            rematchRedux.queue:AddPetID(petID)
+        end
+        rematchRedux.queue:Process()
+        rematchRedux.queue:BlingPetID(petID)
+    end
+end
+
+-- adds pet to top of leveling queue
+function rematchRedux.petMenu:StartQueueFunc(petID)
+    rematchRedux.queue:InsertPetID(petID,1)
+    rematchRedux.queue:Process()
+    rematchRedux.queue:BlingPetID(petID)
+end
+
+function rematchRedux.petMenu:MovePetInQueue(petID)
+    C_PetJournal.PickupPet(petID)
+end
+
+function rematchRedux.petMenu:NotInTeam(petID)
+    local numTeams = rematchRedux.petInfo:Fetch(petID).numTeams
+    return not numTeams or numTeams==0
+end
+
+function rematchRedux.petMenu:ListTeams(petID)
+    if petID and petID:match(C.PET_ID_PATTERN) then
+        rematchRedux.layout:SummonView("teams")
+        rematchRedux.teamsPanel:SetSearch(petID)
+    end
+end
+
+function rematchRedux.petMenu:RenameMarker()
+	rematchRedux.dialog:ShowDialog("RenamePetMarkerDialog",self.key)
+end
+
+function rematchRedux.petMenu:IsMarkerChecked(petID)
+    local marker = rematchRedux.petInfo:Fetch(petID).marker
+    return (not marker and self.key==9) or marker==self.key
 end
