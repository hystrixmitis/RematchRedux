+        self.Left:SetTexCoord(0.375,0.40625,0.75,0.84375)
+        self.Mid:SetTexCoord(0.40625,0.48828125,0.75,0.84375)
+        self.Right:SetTexCoord(0.48828125,0.51953125,0.75,0.84375)
+        self.Text:SetTextColor(1,1,1)
+        for i=1,3 do
