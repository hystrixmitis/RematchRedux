+        end
+    else
+        self.Left:SetTexCoord(0.1875,0.21875,0.75,0.84375)
+        self.Mid:SetTexCoord(0.21875,0.30078125,0.75,0.84375)
+        self.Right:SetTexCoord(0.30078125,0.33203125,0.75,0.84375)
+        self.Text:SetTextColor(1,0.82,0)
+    end
+end
