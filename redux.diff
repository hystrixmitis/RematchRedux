+function RematchReduxDialogTeamPickerMixin:OnLoad()
+    self.Lister.Top.AddButton:SetText(C.ADD_TEXT_ICON..L[" Add"])
+    self.Lister.Top.DeleteButton:SetText(C.DELETE_TEXT_ICON..L[" Delete"])
