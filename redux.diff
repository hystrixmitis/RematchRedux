+function RematchReduxTypeBarTabMixin:OnMouseUp()
+    self.Text:SetPoint("CENTER",0,-1)
+end
+
+function RematchReduxTypeBarTabMixin:OnClick()
+    settings.TypeBarTab = self.id
+    self:GetParent():Update()
+end
