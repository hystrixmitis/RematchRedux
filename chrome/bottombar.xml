<Ui>
    <Frame parentKey="BottomBar" parent="RematchReduxFrame">
        <Frames>
            <Button parentKey="SummonButton" inherits="RematchReduxPanelButtonTemplate,RematchReduxTooltipScripts">
                <Size x="120" y="23"/>
                <Anchors>
                    <Anchor point="BOTTOMLEFT"/>
                </Anchors>
            </Button>
            <Button parentKey="FindBattleButton" inherits="RematchReduxPanelButtonTemplate,RematchReduxTooltipScripts">
                <Size x="120" y="23"/>
                <Anchors>
                    <Anchor point="BOTTOMRIGHT"/>
                </Anchors>
            </Button>
            <Button parentKey="SaveAsButton" inherits="RematchReduxPanelButtonTemplate,RematchReduxTooltipScripts">
                <Size x="120" y="23"/>
                <Anchors>
                    <Anchor point="BOTTOMRIGHT" relativeKey="$parent.FindBattleButton" relativePoint="BOTTOMLEFT"/>
                </Anchors>
            </Button>
            <Button parentKey="SaveButton" inherits="RematchReduxPanelButtonTemplate,RematchReduxTooltipScripts">
                <Size x="120" y="23"/>
                <Anchors>
                    <Anchor point="BOTTOMRIGHT" relativeKey="$parent.SaveAsButton" relativePoint="BOTTOMLEFT"/>
                </Anchors>
            </Button>

            <CheckButton parentKey="UseRematchReduxCheckButton" inherits="RematchReduxCheckButtonTemplate,RematchReduxTooltipScripts">
                <Anchors>
                    <Anchor point="LEFT" relativeKey="$parent.SummonButton" relativePoint="RIGHT" x="0" y="0"/>
                </Anchors>
            </CheckButton>
        </Frames>
        <Scripts>
            <OnShow>
                self:OnShow()
            </OnShow>
            <OnHide>
                self:OnHide()
            </OnHide>
        </Scripts>
    </Frame>

    <Script file="bottombar.lua"/>
</Ui>